<footer class="ll-footer ll-wrap">
  <span>© {{ buildYear }} {{ site.author }}</span>
  <div>
    {% if appName %}
      <a href="{{ appUrl }}">{{ appName }}</a>
      <a href="{{ supportUrl }}">Support</a>
      {% if privacyUrl %}<a href="{{ privacyUrl }}">Privacy</a>{% endif %}
    {% else %}
      <a href="/#apps">Apps</a>
    {% endif %}
    <a href="mailto:{{ appEmail or site.email }}">Contact</a>
  </div>
</footer>
