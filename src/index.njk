---
layout: layouts/base.njk
bodyClass: page-landing
---

<button id="theme-toggle" class="theme-toggle" aria-label="Toggle color theme" title="Toggle theme">🌙</button>

<main class="landing">
  <div class="landing-glow" aria-hidden="true"></div>

  <div class="landing-inner">
    <h1 class="landing-name">Lauren Leppert</h1>

    <p class="landing-tagline">
      <span class="landing-role">Software QA Engineer</span>
      <span class="landing-subrole">Designing thoughtful software experiences</span>
    </p>

    <div class="landing-bio">
      <p>Hi, I&rsquo;m Lauren.</p>
      <p>
        I&rsquo;m a Software QA Engineer with a passion for thoughtful product design
        and creating software that&rsquo;s enjoyable to use. Outside of work, you&rsquo;ll
        usually find me at an amusement park or working on Coastory, a mobile app
        inspired by my love of roller coasters and the stories behind them.
      </p>
    </div>

    <nav class="landing-links" aria-label="Contact links">
      <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:{{ site.email }}">Contact</a>
    </nav>
  </div>

  <footer class="landing-footer">
    <p>&copy; <span id="year"></span> {{ site.author }}</p>
    <script>document.getElementById('year').textContent = new Date().getFullYear();</script>
  </footer>
</main>
